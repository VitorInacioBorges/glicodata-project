APP_NAME=GlicoData
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://glicodata.example.gov.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

HASH_DRIVER=argon2id
# Manter false durante a transição de hashes legados; mudar para true após
# todos os logins/credenciais terem sido regravados em Argon2id.
HASH_VERIFY=false
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=glicodata
DB_USERNAME=glicodata_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=glicodata_

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GlicoData

VITE_APP_NAME=GlicoData
