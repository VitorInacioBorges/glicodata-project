[Unit]
Description=Executa o scheduler do GlicoData
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/glicodata/current/glicodata
ExecStart=/usr/bin/php artisan schedule:run
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/glicodata/current/glicodata/storage /var/www/glicodata/current/glicodata/bootstrap/cache
