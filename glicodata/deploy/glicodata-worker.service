[Unit]
Description=GlicoData Laravel queue worker
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/glicodata/current/glicodata
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --timeout=90
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/glicodata/current/glicodata/storage /var/www/glicodata/current/glicodata/bootstrap/cache

[Install]
WantedBy=multi-user.target
